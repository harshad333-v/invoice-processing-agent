# Copy this file to .env. Never commit real credentials or cookies.
# GeminiWeb API OpenAI-compatible endpoint (adjust host/port if your proxy differs).
LLM_BASE_URL=http://localhost:8081/v1
# Use a key configured in GeminiWeb API config.json; if API auth is disabled, use a placeholder.
LLM_API_KEY=replace-with-your-configured-key
# Vision-capable model exposed by the GeminiWeb API proxy.
LLM_MODEL=gemini-3.6-flash
MAX_EXTRACTION_RETRIES=2
DATABASE_URL=sqlite:///./invoice_agent.db
